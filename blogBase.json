ckground-color: #0b0f19 !important;\n    background-image: radial-gradient(circle at 15% 15%, rgba(147, 51, 234, 0.08) 0%, transparent 40%),\n                      radial-gradient(circle at 85% 85%, rgba(59, 130, 246, 0.08) 0%, transparent 40%) !important;\n    background-attachment: fixed !important;\n}\n\n/* \ud83c\udf1f 1. \u5f7b\u5e95\u6e05\u9664\u591a\u4f59\u526f\u6807\u9898 */\n#subTitle, .subTitle, #subtitle, .subtitle, [class*=\"subTitle\"], [id*=\"subTitle\"], .site-subtitle {\n    display: none !important;\n    visibility: hidden !important;\n    height: 0 !important;\n    overflow: hidden !important;\n    position: absolute !important;\n    top: -9999px !important;\n}\n\n/* \ud83c\udf1f 2. Apple \u98ce\u683c\u9876\u680f\u4e0e\u5f39\u6027\u5e03\u5c40 */\n#header, .subnav {\n    display: flex !important;\n    flex-wrap: wrap !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n    width: 100% !important;\n    position: relative !important;\n    padding-bottom: 14px !important;\n    border-bottom: 1px solid rgba(147, 51, 234, 0.15) !important;\n    gap: 12px 0 !important;\n}\n\n.title-right, .subnav-right {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: flex-end !important;\n    gap: 10px !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 3. \u4e8c\u6b21\u5143\u52a8\u611f\u6bdb\u73bb\u7483\u6309\u94ae (\u9996\u9875/\u641c\u7d22/\u4e3b\u9898) */\n#buttonHome, #buttonSearch, #buttonTheme, a.btn-invisible.circle {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 38px !important;\n    height: 38px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: 1px solid rgba(147, 51, 234, 0.3) !important;\n    background: rgba(255, 255, 255, 0.7) !important;\n    border-radius: 50% !important;\n    backdrop-filter: blur(12px) !important;\n    -webkit-backdrop-filter: blur(12px) !important;\n    box-shadow: 0 4px 12px rgba(147, 51, 234, 0.08) !important;\n    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1) !important;\n}\n[data-color-mode=\"dark\"] #buttonHome, [data-color-mode=\"dark\"] #buttonSearch, [data-color-mode=\"dark\"] #buttonTheme, [data-color-mode=\"dark\"] a.btn-invisible.circle {\n    background: rgba(30, 27, 75, 0.6) !important;\n    border-color: rgba(168, 85, 247, 0.4) !important;\n}\n#buttonHome:hover, #buttonSearch:hover, #buttonTheme:hover, a.btn-invisible.circle:hover {\n    transform: translateY(-2px) scale(1.05);\n    border-color: #a855f7 !important;\n    box-shadow: 0 0 15px rgba(168, 85, 247, 0.4) !important;\n}\n#buttonHome svg, #buttonTheme svg, #buttonSearch svg, a.btn-invisible svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #9333ea !important;\n    margin: 0 !important;\n    transition: fill 0.2s;\n}\n[data-color-mode=\"dark\"] #buttonHome svg, [data-color-mode=\"dark\"] #buttonTheme svg, [data-color-mode=\"dark\"] #buttonSearch svg, [data-color-mode=\"dark\"] a.btn-invisible svg {\n    fill: #c084fc !important;\n}\n\n/* \ud83c\udf1f 4. \u5de6\u4e0a\u89d2\u4e8c\u6b21\u5143\u53d1\u5149\u54c1\u724c\u80f6\u56ca */\n.pro-brand-capsule {\n    display: inline-flex !important;\n    align-items: center;\n    padding: 4px 14px 4px 6px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(243, 232, 255, 0.8) 100%) !important;\n    border: 1px solid rgba(147, 51, 234, 0.4) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 4px 16px rgba(147, 51, 234, 0.12) !important;\n    text-decoration: none !important;\n    height: 38px !important;\n    box-sizing: border-box !important;\n    backdrop-filter: blur(10px) !important;\n    transition: all 0.3s ease !important;\n}\n[data-color-mode=\"dark\"] .pro-brand-capsule {\n    background: linear-gradient(135deg, rgba(30, 27, 75, 0.8) 0%, rgba(49, 46, 129, 0.6) 100%) !important;\n    border-color: rgba(168, 85, 247, 0.4) !important;\n    box-shadow: 0 4px 20px rgba(147, 51, 234, 0.25) !important;\n}\n.pro-brand-capsule:hover {\n    transform: scale(1.02);\n    border-color: #c084fc !important;\n    box-shadow: 0 0 20px rgba(168, 85, 247, 0.5) !important;\n}\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 27px !important;\n    height: 27px !important;\n    border-radius: 50% !important;\n    object-fit: cover;\n    margin-right: 8px !important;\n    border: 1.5px solid #a855f7 !important;\n}\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    line-height: 1.1;\n}\nh1.pro-brand-title, .pro-brand-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    line-height: 1 !important;\n    background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n.pro-brand-subtitle {\n    font-size: 7.5px !important;\n    font-weight: 700 !important;\n    color: #7c3aed !important;\n    letter-spacing: 1.2px;\n}\n[data-color-mode=\"dark\"] .pro-brand-subtitle {\n    color: #e879f9 !important;\n}\n\n/* \ud83c\udf1f 5. \u8d5b\u535a\u52a8\u611f\u5168\u5bbd\u641c\u7d22\u680f */\n.subnav-search, div[search] {\n    flex: 0 0 100% !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 44px !important;\n    margin: 4px 0 0 0 !important;\n    padding: 0 6px 0 16px !important;\n    background: rgba(255, 255, 255, 0.8) !important;\n    backdrop-filter: blur(16px) !important;\n    border: 1.5px solid rgba(147, 51, 234, 0.3) !important;\n    border-radius: 22px !important;\n    box-shadow: 0 4px 20px rgba(147, 51, 234, 0.08) !important;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n    transition: all 0.3s ease !important;\n}\n[data-color-mode=\"dark\"] .subnav-search, \n[data-color-mode=\"dark\"] div[search] {\n    background: rgba(18, 16, 38, 0.75) !important;\n    border-color: rgba(168, 85, 247, 0.35) !important;\n}\n.subnav-search:focus-within, div[search]:focus-within {\n    border-color: #a855f7 !important;\n    box-shadow: 0 0 20px rgba(168, 85, 247, 0.3) !important;\n}\n.subnav-search input, div[search] input {\n    flex: 1 !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    color: var(--color-fg-default) !important;\n    font-size: 14px !important;\n}\n.subnav-search button, div[search] button {\n    height: 32px !important;\n    padding: 0 18px !important;\n    background: linear-gradient(135deg, #9333ea, #ec4899) !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 16px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n    box-shadow: 0 2px 10px rgba(147, 51, 234, 0.3) !important;\n    cursor: pointer;\n    transition: opacity 0.2s;\n}\n.subnav-search button:hover, div[search] button:hover {\n    opacity: 0.9;\n}\n\n/* \ud83c\udf1f 6. \u4e8c\u6b21\u5143\u547c\u5438\u9713\u8679\u7cfb\u7edf\u516c\u544a\u5361\u7247 */\n.pro-notice-card {\n    width: 100% !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 50%, #3b0764 100%) !important;\n    border: 1px solid rgba(192, 132, 252, 0.35) !important;\n    border-radius: 16px !important;\n    padding: 14px 18px !important;\n    margin: 14px 0 18px 0 !important;\n    color: #f3e8ff !important;\n    box-shadow: 0 8px 30px rgba(147, 51, 234, 0.2) !important;\n    position: relative;\n    overflow: hidden;\n}\n.pro-notice-card::before {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 100%;\n    height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.08), transparent);\n 