77\u5916 Apple ID \u4e0e\u5c0f\u706b\u7bad\u8d26\u53f7 - \u79d1\u6280\u5c9b\",\"isPartOf\":{\"@id\":\"https://kjdid.com/#website\"},\"description\":\"\u79d1\u6280\u5c9b\uff08kjdid.com\uff09\u662f\u4e13\u4e1a\u7684\u514d\u8d39\u82f9\u679cID\u5171\u4eab\u4e0e\u5c0f\u706b\u7bad Shadowrocket \u8d26\u53f7\u83b7\u53d6\u5e73\u53f0\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7f8e\u533a\u3001\u6e2f\u533a\u3001\u65e5\u533a\u3001\u53f0\u533a\u7b49\u70ed\u95e8\u6d77\u5916 Apple ID \u82f9\u679c\u5171\u4eab\u8d26\u53f7\uff0c\u914d\u5957 2FA \u53cc\u91cd\u8ba4\u8bc1\u5728\u7ebf\u9a8c\u8bc1\u7801\u5b9e\u65f6\u63d0\u53d6\u5de5\u5177\uff0c\u52a9\u60a8\u514d\u9501\u7545\u73a9\u5168\u7403 App Store \u70ed\u95e8\u5e94\u7528\uff01\",\"inLanguage\":\"zh-CN\"},{\"@type\":\"FAQPage\",\"@id\":\"https://kjdid.com/#faq\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"\u79d1\u6280\u5c9b\u63d0\u4f9b\u7684\u6d77\u5916\u82f9\u679c ID \u5305\u542b\u54ea\u4e9b\u5730\u533a\uff1f\u662f\u514d\u8d39\u7684\u5417\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u662f\u7684\uff0c\u79d1\u6280\u5c9b\u5168\u7ad9\u514d\u8d39\u3002\u6bcf\u65e5\u5b9e\u65f6\u66f4\u65b0\u7f8e\u533a\u3001\u6e2f\u533a\u3001\u65e5\u533a\u3001\u53f0\u533a\u7b49\u70ed\u95e8\u6d77\u5916\u516c\u5171\u5171\u4eab\u82f9\u679c ID\u3002\"}},{\"@type\":\"Question\",\"name\":\"\u5982\u4f55\u83b7\u53d6\u5c0f\u706b\u7bad\uff08Shadowrocket\uff09\u5171\u4eab\u8d26\u53f7\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u60a8\u53ef\u4ee5\u5728\u5e73\u53f0\u83b7\u53d6\u5df2\u8d2d\u4e70\u5c0f\u706b\u7bad\u7684\u6d77\u5916\u82f9\u679c ID\uff0c\u767b\u5f55 App Store \u5373\u53ef\u514d\u8d39\u4e0b\u8f7d\u3002\"}},{\"@type\":\"Question\",\"name\":\"\u5171\u4eab\u82f9\u679c\u8d26\u53f7\u63d0\u793a\u9700\u8981 2FA \u9a8c\u8bc1\u7801\u600e\u4e48\u529e\uff1f\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\u79d1\u6280\u5c9b\u63d0\u4f9b\u914d\u5957\u7684\u5728\u7ebf 2FA \u9a8c\u8bc1\u7801\u63d0\u53d6\u5de5\u5177\uff0c\u8f93\u5165\u8d26\u53f7\u5bf9\u5e94\u7684\u5bc6\u94a5\u5373\u53ef\u5b9e\u65f6\u83b7\u53d6 6 \u4f4d\u53cc\u91cd\u8ba4\u8bc1\u9a8c\u8bc1\u7801\u3002\"}}]},{\"@type\":\"Organization\",\"@id\":\"https://kjdid.com/#organization\",\"name\":\"\u79d1\u6280\u5c9b\",\"url\":\"https://kjdid.com/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://raw.githubusercontent.com/tghaocc/tghaocc.github.io/refs/heads/main/IMG_4794.png\"}}]}</script>\n<style>\n/* =========================================================\n   \ud83c\udf4f Apple \u6781\u7b80\u6bdb\u73bb\u7483 + \u26a1 \u8d5b\u535a\u4e8c\u6b21\u5143\u6d41\u5149\u9713\u8679\u7f8e\u5316\u65b9\u6848\n   ========================================================= */\n\nbody {\n    background-color: var(--color-canvas-default, #f8fafc) !important;\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"SF Pro Text\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif !important;\n}\n[data-color-mode=\"dark\"] body {\n    background-color: #070913 !important;\n    background-image: radial-gradient(circle at 10% 10%, rgba(147, 51, 234, 0.12) 0%, transparent 45%),\n                      radial-gradient(circle at 90% 90%, rgba(59, 130, 246, 0.1) 0%, transparent 45%),\n                      radial-gradient(circle at 50% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 60%) !important;\n    background-attachment: fixed !important;\n}\n\n/* \u5f7b\u5e95\u6df1\u5ea6\u7ede\u6740\u9875\u9762\u4e0a\u4efb\u4f55\u8f93\u51fa\u526f\u6807\u9898\u7684\u5783\u573e\u5143\u7d20 */\n#subTitle, .subTitle, #subtitle, .subtitle, [class*=\"subTitle\"], [id*=\"subTitle\"], .site-subtitle {\n    display: none !important;\n    visibility: hidden !important;\n    height: 0 !important;\n    overflow: hidden !important;\n    position: absolute !important;\n    top: -9999px !important;\n}\n\n/* SEO \u4e13\u7528\u9ec4\u91d1 H1 \u9690\u85cf\u6807\u7b7e */\n.seo-main-h1 {\n    font-size: 1px !important;\n    opacity: 0.01 !important;\n    position: absolute !important;\n    width: 1px !important;\n    height: 1px !important;\n    padding: 0 !important;\n    margin: -1px !important;\n    overflow: hidden !important;\n    clip: rect(0, 0, 0, 0) !important;\n    white-space: nowrap !important;\n    border: 0 !important;\n}\n\n/* \u9876\u680f\u4e0e\u8be6\u60c5\u9875\u5f3a\u5236\u5355\u884c\u5e03\u5c40\u91cd\u6784 */\n#header, .subnav {\n    display: flex !important;\n    flex-direction: column !important;\n    width: 100% !important;\n    position: relative !important;\n    padding-bottom: 16px !important;\n    border-bottom: 1px solid rgba(168, 85, 247, 0.15) !important;\n    gap: 12px !important;\n}\n\n/* JS\u91cd\u6784\u540e\u7684\u9876\u90e8\u7b2c\u4e00\u884c\u5bb9\u5668\uff1a\u5de6\u4fa7Logo + \u53f3\u4fa7\u529f\u80fd\u6309\u94ae */\n.pro-top-row {\n    display: flex !important;\n    flex-direction: row !important;\n    flex-wrap: nowrap !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n    width: 100% !important;\n    gap: 10px !important;\n}\n\n.title-right, .subnav-right {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: flex-end !important;\n    gap: 8px !important;\n    margin: 0 !important;\n    flex-shrink: 0 !important;\n}\n\n/* \u9876\u90e8\u529f\u80fd\u6309\u94ae\uff1a\u4e8c\u6b21\u5143\u52a8\u611f\u6bdb\u73bb\u7483\u5706\u5f62\u5916\u89c2 */\n#buttonHome, #buttonSearch, #buttonTheme, a.btn-invisible.circle {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 40px !important;\n    height: 40px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: 1px solid rgba(168, 85, 247, 0.25) !important;\n    background: rgba(255, 255, 255, 0.75) !important;\n    border-radius: 50% !important;\n    backdrop-filter: blur(14px) !important;\n    -webkit-backdrop-filter: blur(14px) !important;\n    box-shadow: 0 4px 15px rgba(147, 51, 234, 0.08) !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    flex-shrink: 0 !important;\n}\n[data-color-mode=\"dark\"] #buttonHome, [data-color-mode=\"dark\"] #buttonSearch, [data-color-mode=\"dark\"] #buttonTheme, [data-color-mode=\"dark\"] a.btn-invisible.circle {\n    background: rgba(23, 21, 51, 0.65) !important;\n    border-color: rgba(192, 132, 252, 0.35) !important;\n    box-shadow: 0 4px 20px rgba(147, 51, 234, 0.2) !important;\n}\n#buttonHome:hover, #buttonSearch:hover, #buttonTheme:hover, a.btn-invisible.circle:hover {\n    transform: translateY(-3px) scale(1.08);\n    border-color: #c084fc !important;\n    box-shadow: 0 0 20px rgba(192, 132, 252, 0.5) !important;\n}\n#buttonHome svg, #buttonTheme svg, #buttonSearch svg, a.btn-invisible svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #9333ea !important;\n    margin: 0 !important;\n    transition: fill 0.2s;\n}\n[data-color-mode=\"dark\"] #buttonHome svg, [data-color-mode=\"dark\"] #buttonTheme svg, [data-color-mode=\"dark\"] #buttonSearch svg, [data-color-mode=\"dark\"] a.btn-invisible svg {\n    fill: #e879f9 !important;\n}\n\n/* \u5de6\u4e0a\u89d2\u54c1\u724c\u9ad8\u7ea7\u9713\u8679\u80f6\u56ca */\n.pro-brand-capsule {\n    display: inline-flex !important;\n    align-items: center;\n    padding: 5px 12px 5px 6px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(243, 232, 255, 0.9) 100%) !important;\n    border: 1.5px solid rgba(168, 85, 247, 0.35) !important;\n    border-radius: 32px !important;\n    box-shadow: 0 4px 20px rgba(147, 51, 234, 0.12) !important;\n    text-decoration: none !important;\n    height: 40px !important;\n    box-sizing: border-box !important;\n    backdrop-filter: blur(12px) !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    flex-shrink: 1 !important;\n    min-width: 0 !important;\n}\n[data-color-mode=\"dark\"] .pro-brand-capsule {\n    background: linear-gradient(135deg, rgba(23, 21, 51, 0.85) 0%, rgba(49, 46, 129, 0.7) 100%) !important;\n    border-color: rgba(192, 132, 252, 0.4) !important;\n    box-shadow: 0 4px 25px rgba(147, 51, 234, 0.3) !important;\n}\n.pro-brand-capsule:hover {\n    transform: scale(1.03);\n    border-color: #e879f9 !important;\n    box-shadow: 0 0 25px rgba(232, 121, 249, 0.5) !important;\n}\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 28px !important;\n    height: 28px !important;\n    border-radius: 50% !important;\n    object-fit: cover;\n    margin-right: 7px !important;\n    border: 2px solid #a855f7 !important;\n    flex-shrink: 0 !important;\n}\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    line-height: 1.15;\n    min-width: 0 !important;\n    overflow: hidden !important;\n}\n.pro-brand-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    line-height: 1 !important;\n    background: linear-gradient(135deg, #9333ea 0%, #ec4899 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    white-space: nowrap !important;\n    overflow: hidden !important;\n    text-overflow: ellipsis !important;\n}\n.pro-brand-subtitle {\n    font-size: 8px !important;\n    font-weight: 700 !important;\n    color: #7c3aed !important;\n    letter-spacing: 1px;\n    margin-top: 2px;\n    white-space: nowrap !important;\n}\n[data-color-mode=\"dark\"] .pro-brand-subtitle {\n    color: #f472b6 !important;\n}\n\n/* \u8be6\u60c5\u9875\u6587\u7ae0\u6807\u9898\u7f8e\u5316 */\n#header h1:not(.seo-main-h1), .subnav h1:not(.seo-main-h1), .post-title {\n    font-size: 20px !important;\n    font-weight: 800 !important;\n    line-height: 1.4 !important;\n    color: var(--color-fg-default) !important;\n    margin: 4px 0 0 0 !important;\n    padding: 0 !important;\n    width: 100% !important;\n}\n\n/* \u8d5b\u535a\u5168\u5bbd\u5