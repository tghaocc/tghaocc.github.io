\u80fd\u6309\u94ae */\n#buttonHome, #buttonSearch, #buttonTheme, a.btn-invisible.circle {\n    display: inline-flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    width: 36px !important;\n    height: 36px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    background: rgba(124, 58, 237, 0.08) !important;\n    border-radius: 50% !important;\n    backdrop-filter: blur(8px) !important;\n    -webkit-backdrop-filter: blur(8px) !important;\n    box-sizing: border-box !important;\n}\n\n#buttonHome svg, #buttonTheme svg, #buttonSearch svg, a.btn-invisible svg {\n    width: 18px !important;\n    height: 18px !important;\n    fill: #a78bfa !important;\n    margin: 0 !important;\n}\n\n/* \ud83c\udf1f 4. \u5de6\u4e0a\u89d2\u54c1\u724c\u80f6\u56ca\u5361\u7247 */\n.pro-brand-capsule {\n    display: inline-flex !important;\n    align-items: center;\n    padding: 4px 14px 4px 6px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(243, 232, 255, 0.9) 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.5) !important;\n    border-radius: 30px !important;\n    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.12) !important;\n    text-decoration: none !important;\n    height: 36px !important;\n    box-sizing: border-box !important;\n}\n\n[data-color-mode=\"dark\"] .pro-brand-capsule {\n    background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(49, 46, 129, 0.75) 100%) !important;\n    border-color: rgba(167, 139, 250, 0.35) !important;\n}\n\n.pro-brand-capsule img, .pro-brand-capsule .avatar {\n    width: 26px !important;\n    height: 26px !important;\n    border-radius: 50% !important;\n    object-fit: cover;\n    margin-right: 8px !important;\n}\n\n.pro-brand-text {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    line-height: 1.1;\n}\n\nh1.pro-brand-title, .pro-brand-title {\n    font-size: 14px !important;\n    font-weight: 800 !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    line-height: 1 !important;\n    background: linear-gradient(135deg, #7c3aed 0%, #2563eb 100%);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n}\n\n.pro-brand-subtitle {\n    font-size: 7.5px !important;\n    font-weight: 700 !important;\n    color: #6b7280 !important;\n    letter-spacing: 1px;\n}\n\n/* \ud83c\udf1f 5. \u5168\u5bbd\u6c89\u6d78\u5f0f\u641c\u7d22\u680f */\n.subnav-search, div[search] {\n    flex: 0 0 100% !important;\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 42px !important;\n    margin: 4px 0 0 0 !important;\n    padding: 0 4px 0 14px !important;\n    background: rgba(255, 255, 255, 0.85) !important;\n    backdrop-filter: blur(12px) !important;\n    border: 1.5px solid rgba(167, 139, 250, 0.4) !important;\n    border-radius: 21px !important;\n    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.08) !important;\n    box-sizing: border-box !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n}\n\n[data-color-mode=\"dark\"] .subnav-search, \n[data-color-mode=\"dark\"] div[search] {\n    background: rgba(22, 20, 52, 0.85) !important;\n}\n\n.subnav-search input, div[search] input {\n    flex: 1 !important;\n    background: transparent !important;\n    border: none !important;\n    outline: none !important;\n    color: var(--color-fg-default) !important;\n    font-size: 14px !important;\n}\n\n.subnav-search button, div[search] button {\n    height: 32px !important;\n    padding: 0 16px !important;\n    background: linear-gradient(135deg, #7c3aed, #4f46e5) !important;\n    color: #ffffff !important;\n    border: none !important;\n    border-radius: 16px !important;\n    font-size: 13px !important;\n    font-weight: 700 !important;\n}\n\n/* \ud83c\udf1f 6. \u7cfb\u7edf\u516c\u544a\u5361\u7247 */\n.pro-notice-card {\n    width: 100% !important;\n    box-sizing: border-box !important;\n    background: linear-gradient(135deg, #2e1065 0%, #1e1b4b 50%, #0f172a 100%) !important;\n    border: 1px solid rgba(167, 139, 250, 0.3) !important;\n    border-radius: 14px !important;\n    padding: 12px 14px !important;\n    margin: 12px 0 16px 0 !important;\n    color: #f1f5f9 !important;\n}\n.pro-notice-header { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }\n.pro-notice-badge1 { background: linear-gradient(135deg, #7c3aed, #4f46e5); color: #fff; font-size: 10.5px; font-weight: 700; padding: 2px 8px; border-radius: 5px; }\n.pro-notice-badge2 { background: rgba(255, 255, 255, 0.1); color: #c084fc; font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 5px; }\n.pro-notice-body { font-size: 12.5px !important; line-height: 1.65 !important; color: #cbd5e1 !important; }\n</style>\n\n<script>\n(function() {\n    if (window.__PRO_THEME_INITED__) return;\n    window.__PRO_THEME_INITED__ = true;\n\n    function cleanUI() {\n        var subEls = document.querySelectorAll('#subTitle, .subTitle, #subtitle, .subtitle, [class*=\"subTitle\"], [id*=\"subTitle\"]');\n        subEls.forEach(function(el) {\n            el.style.setProperty('display', 'none', 'important');\n            el.style.setProperty('height', '0', 'important');\n            el.style.setProperty('overflow', 'hidden', 'important');\n        });\n        var footer = document.getElementById('footer');\n        if (footer) {\n            footer.innerHTML = 'Copyright \u00a9 2026 <a href=\"https://kjdid.com/\">\u79d1\u6280\u5c9b</a><br><span style=\"font-size: 12px; color: #888;\">Powered by <a href=\"https://meekdai.com/Gmeek.html\" target=\"_blank\">Gmeek</a></span>';\n        }\n    }\n\n    function initProTheme() {\n        let headerContainer = document.getElementById(\"header\") || document.querySelector(\".subnav\");\n        if (headerContainer) {\n            let searchBox = 